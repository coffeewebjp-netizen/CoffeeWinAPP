<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Coffee AutoButton"
    Manufacturer="Coffee AutoButton"
    Version="$(var.AppVersion)"
    UpgradeCode="{6F0E97B2-4B68-49F0-BD83-379967C6DD20}"
    Scope="perUser">

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Coffee AutoButton is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <ui:WixUI Id="WixUI_Minimal" />
    <Icon Id="CoffeeAutoButtonIcon" SourceFile="$(var.PublishDir)\CoffeeAutoButton.exe" />
    <Property Id="ARPPRODUCTICON" Value="CoffeeAutoButtonIcon" />

    <Feature Id="MainFeature" Title="Coffee AutoButton" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="StartMenuTopShortcutComponent" />
      <ComponentRef Id="StartMenuAliasShortcutComponent" />
    </Feature>

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="CoffeeAutoButton" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Coffee AutoButton" />
    </StandardDirectory>

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Component Id="ExeComponent" Guid="{113990A7-72EF-44E2-A999-E9F704E91D8B}">
        <File Id="CoffeeAutoButtonExe" Source="$(var.PublishDir)\CoffeeAutoButton.exe" KeyPath="yes" />
      </Component>
      <Component Id="DllComponent" Guid="{413B2062-C587-4F11-AC6F-C38904B47763}">
        <File Source="$(var.PublishDir)\CoffeeAutoButton.dll" KeyPath="yes" />
      </Component>
      <Component Id="DepsComponent" Guid="{A57EB7D6-9303-43DC-AC80-839B7D675FEF}">
        <File Source="$(var.PublishDir)\CoffeeAutoButton.deps.json" KeyPath="yes" />
      </Component>
      <Component Id="RuntimeConfigComponent" Guid="{F4CB2D62-8484-4267-BB5D-C37B8D844487}">
        <File Source="$(var.PublishDir)\CoffeeAutoButton.runtimeconfig.json" KeyPath="yes" />
      </Component>
      <Component Id="AppConfigComponent" Guid="{1BC8BC4E-ED67-453F-A1F7-160C5295827D}">
        <File Source="$(var.PublishDir)\CoffeeAutoButton.dll.config" KeyPath="yes" />
      </Component>
      <Component Id="InputSimulatorComponent" Guid="{E58A9C74-11C5-4CB3-B3C2-86746972864B}">
        <File Source="$(var.PublishDir)\GregsStack.InputSimulatorStandard.dll" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="{C5EBF404-D0E1-47CA-B2F0-974E48B2B8AA}">
      <Shortcut
        Id="ApplicationStartMenuShortcut"
        Name="Coffee AutoButton"
        Icon="CoffeeAutoButtonIcon"
        Target="[INSTALLFOLDER]CoffeeAutoButton.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFile Id="RemoveLegacyUninstallShortcut" Name="Uninstall Coffee AutoButton.lnk" On="both" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\CoffeeAutoButton" Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuTopShortcutComponent" Directory="ProgramMenuFolder" Guid="{2D2E56A7-57DB-4355-A90B-1E9EAD5676BF}">
      <Shortcut
        Id="ApplicationStartMenuTopShortcut"
        Name="Coffee AutoButton"
        Icon="CoffeeAutoButtonIcon"
        Target="[INSTALLFOLDER]CoffeeAutoButton.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\CoffeeAutoButton" Name="topShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuAliasShortcutComponent" Directory="ProgramMenuFolder" Guid="{661FE892-DF3E-4D81-A391-BEA11CD23EF1}">
      <Shortcut
        Id="ApplicationStartMenuAliasShortcut"
        Name="CoffeeAutoButton"
        Icon="CoffeeAutoButtonIcon"
        Target="[INSTALLFOLDER]CoffeeAutoButton.exe"
        WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\CoffeeAutoButton" Name="aliasShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Package>
</Wix>
